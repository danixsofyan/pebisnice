# Copy to .env.local for local development, then run: pnpm env:check

# Required. Use the transaction pooler (port 6543) in production; port 5432 for pnpm db:migrate.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres"

# Required. Signs session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Required. Google Cloud Console credentials.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required. Encrypts marketplace tokens. Generate: openssl rand -base64 32
ENCRYPTION_SECRET_KEY=""

# Required. Guards /api/v1/cron/*. Generate: openssl rand -hex 32
CRON_SECRET=""

# Optional. Pino log level, defaults to info.
LOG_LEVEL="info"

# Optional. Midtrans Snap keys from the dashboard, Sandbox or Production.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""

# Optional. Set true only for live Midtrans; defaults to sandbox.
MIDTRANS_IS_PRODUCTION="false"

# Optional. Private S3-compatible bucket, server-only. Files are served via the app proxy, never a public URL. Set all five or leave all empty.
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="pebisnice"

# Reserved. Shopee sync, not implemented yet.
SHOPEE_API_BASE_URL="https://partner.shopeemobile.com/api/v2"
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""

# Reserved. TikTok Shop sync, not implemented yet.
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""

# Transactional email via SMTP (Brevo relay). Leave blank to disable sending (emails become a
# logged no-op in dev). Set the real SMTP key in Vercel env / .env.local only — never commit it.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Pebisnice <no-reply@pebisnice.my.id>"
