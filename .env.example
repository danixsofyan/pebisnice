# =============================================================
# Pebisnice — variabel lingkungan
#
# Salin ke .env.local untuk pengembangan lokal:
#   cp .env.example .env.local
#
# Periksa kelengkapannya kapan saja dengan:
#   pnpm env:check
# =============================================================


# -------------------------------------------------------------
# WAJIB — aplikasi tidak berjalan benar tanpa ini
# -------------------------------------------------------------

# Koneksi PostgreSQL.
# Produksi (Vercel): pakai TRANSACTION POOLER port 6543, bukan koneksi
# langsung port 5432. Serverless membuka koneksi baru tiap invocation dan
# akan menghabiskan connection limit Postgres.
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Untuk `pnpm db:migrate` pakai SESSION POOLER port 5432 — drizzle butuh sesi.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres"

# Kunci penandatangan sesi Auth.js.
# WAJIB acak. Nilai yang bisa ditebak berarti cookie sesi bisa dipalsukan.
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=""

# Kredensial Google OAuth dari Google Cloud Console.
# Authorized redirect URI: https://<domain-anda>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Kunci enkripsi token marketplace (AES-256-GCM).
# Buat dengan: openssl rand -base64 32
# JANGAN diganti setelah ada token tersimpan — token lama tidak akan bisa
# didekripsi lagi.
ENCRYPTION_SECRET_KEY=""

# Melindungi endpoint /api/v1/cron/sync-marketplace.
# Tanpa ini seluruh request cron ditolak 401.
# Buat dengan: openssl rand -hex 32
CRON_SECRET=""


# -------------------------------------------------------------
# OPSIONAL — punya nilai bawaan yang aman
# -------------------------------------------------------------

# Host Supabase Storage untuk gambar yang diunggah pengguna.
# Kosongkan bila belum ada fitur unggah. Latar halaman login TIDAK memakai
# ini — berkasnya ada di public/login-background.webp.
# Format: <ref>.supabase.co
NEXT_PUBLIC_SUPABASE_STORAGE_HOST=""

# Level log pino. Bawaan: info
LOG_LEVEL="info"


# -------------------------------------------------------------
# BELUM DIPAKAI — disiapkan untuk fitur yang belum dibangun
#
# Tidak perlu diisi sekarang. Dibiarkan di sini sebagai catatan apa yang
# dibutuhkan saat fiturnya dikerjakan.
# -------------------------------------------------------------

# Sinkronisasi Shopee (connector belum diimplementasikan)
SHOPEE_API_BASE_URL="https://partner.shopeemobile.com/api/v2"
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""

# Sinkronisasi TikTok Shop (belum diimplementasikan)
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""

# Pengiriman email undangan tim (belum diimplementasikan)
RESEND_API_KEY=""
EMAIL_FROM="Pebisnice <noreply@pebisnice.my.id>"
